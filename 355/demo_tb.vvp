#! /usr/local/Cellar/icarus-verilog/11.0/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/local/Cellar/icarus-verilog/11.0/lib/ivl/system.vpi";
:vpi_module "/usr/local/Cellar/icarus-verilog/11.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/usr/local/Cellar/icarus-verilog/11.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/usr/local/Cellar/icarus-verilog/11.0/lib/ivl/v2005_math.vpi";
:vpi_module "/usr/local/Cellar/icarus-verilog/11.0/lib/ivl/va_math.vpi";
S_0x7fe9a3d064a0 .scope module, "demo_tb" "demo_tb" 2 3;
 .timescale -12 -12;
v0x7fe9a3d19400_0 .var "X", 0 0;
v0x7fe9a3d194b0_0 .net "Y", 0 0, L_0x7fe9a3d19560;  1 drivers
S_0x7fe9a3d05a50 .scope module, "ut" "demo" 2 7, 3 1 0, S_0x7fe9a3d064a0;
 .timescale -12 -12;
    .port_info 0 /INPUT 1 "X";
    .port_info 1 /OUTPUT 1 "Y";
L_0x7fe9a3d19560 .functor BUFZ 1, v0x7fe9a3d19400_0, C4<0>, C4<0>, C4<0>;
v0x7fe9a3d087a0_0 .net "X", 0 0, v0x7fe9a3d19400_0;  1 drivers
v0x7fe9a3d19350_0 .net "Y", 0 0, L_0x7fe9a3d19560;  alias, 1 drivers
    .scope S_0x7fe9a3d064a0;
T_0 ;
    %vpi_call 2 11 "$dumpfile", "demo_tb.vcd" {0 0 0};
    %vpi_call 2 12 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x7fe9a3d064a0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x7fe9a3d19400_0, 0, 1;
    %delay 30, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x7fe9a3d19400_0, 0, 1;
    %delay 30, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x7fe9a3d19400_0, 0, 1;
    %delay 30, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x7fe9a3d19400_0, 0, 1;
    %delay 30, 0;
    %vpi_call 2 26 "$display", "Hello World" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "demo_tb.v";
    "./demo.v";
